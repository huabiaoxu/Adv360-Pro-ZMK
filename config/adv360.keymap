#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        DOUBLE_TICK: DOUBLE_TICK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE>;
            label = "DOUBLE_TICK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        alphanumeric {
            display-name = "Base";
            bindings = <
&DOUBLE_TICK  &kp N1    &kp N2            &kp N3  &kp N4          &kp N5  &tog 2                                                       &kp EQUAL  &kp N6  &kp N7      &kp N8     &kp N9    &kp N0        &kp MINUS
&mo 2         &kp Q     &kp W             &kp E   &kp R           &kp T   &kp LPAR                                                     &kp RPAR   &kp Y   &kp U       &kp I      &kp O     &kp P         &lt 2 BSLH
&kp LCTRL     &kp A     &kp S             &kp D   &kp F           &kp G   &kp LBKT   &kp DEL        &kp HOME       &kp PG_UP  &kp END  &kp RBKT   &kp H   &kp J       &kp K      &kp L     &kp SEMI      &mt RIGHT_COMMAND SQT
&mo 0         &kp Z     &kp X             &kp C   &kp V           &kp B                             &kp LC(W)      &kp PG_DN                      &kp N   &kp M       &kp COMMA  &kp DOT   &kp FSLH      &mo 0
&kp GLOBE     &kp LALT  &kp LEFT_COMMAND  &mo 1   &kp LEFT_SHIFT          &kp SPACE  &kp BACKSPACE  &kp GRAVE      &kp ESC    &kp TAB  &kp RET            &kp RSHIFT  &kp LEFT   &kp DOWN  &kp UP_ARROW  &kp RIGHT
            >;
        };

        numrow {
            display-name = "num";
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans        &trans                                      &trans  &trans        &trans        &trans        &trans        &trans        &trans
&none   &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT     &none                                       &trans  &kp CARET     &kp AMPS      &kp ASTRK     &kp LPAR      &kp RPAR      &none
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &none   &trans  &trans      &trans  &trans  &trans  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp RIGHT_COMMAND
&none   &trans        &trans        &trans        &trans        &trans                        &trans      &trans                  &trans        &trans        &trans        &trans        &trans        &none
&trans  &trans        &trans        &none         &trans                      &trans  &trans  &trans      &trans  &trans  &trans                &trans        &trans        &trans        &trans        &trans
            >;
        };

        vimarrow {
            display-name = "vim";
            bindings = <
&trans  &trans        &trans     &trans     &trans    &trans     &trans                                      &trans  &trans        &trans        &trans      &trans         &trans  &trans
&none   &trans        &trans     &trans     &trans    &trans     &none                                       &none   &kp LC(LEFT)  &kp LA(DOWN)  &kp LA(UP)  &kp LC(RIGHT)  &trans  &none
&trans  &kp NUMBER_0  &kp CARET  &kp PRCNT  &kp DLLR  &kp ASTRK  &none   &trans  &trans      &trans  &trans  &none   &kp LEFT      &kp DOWN      &kp UP      &kp RIGHT      &trans  &trans
&none   &trans        &trans     &kp LBKT   &kp RBKT  &kp HASH                   &trans      &trans                  &kp HOME      &kp PG_DN     &kp PG_UP   &kp END        &trans  &none
&trans  &trans        &trans     &none      &trans               &trans  &trans  &trans      &trans  &trans  &trans                &trans        &trans      &trans         &trans  &trans
            >;
        };

        media {
            display-name = "media";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans      &trans             &trans           &trans
&none   &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans      &trans             &trans           &none
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans      &trans             &trans           &trans
&none   &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans      &trans             &trans           &none
&trans  &trans  &trans  &none   &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_PLAY_PAUSE
            >;
        };
    };
};

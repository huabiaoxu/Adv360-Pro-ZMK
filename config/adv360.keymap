#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        DOUBLE_TICK: DOUBLE_TICK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE>;
            label = "DOUBLE_TICK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        alphanumeric {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1    &kp N2            &kp N3  &kp N4          &kp N5  &tog 2                                                       &kp EQUAL  &kp N6  &kp N7      &kp N8     &kp N9    &kp N0        &kp MINUS
&mo 2      &kp Q     &kp W             &kp E   &kp R           &kp T   &kp LPAR                                                     &kp RPAR   &kp Y   &kp U       &kp I      &kp O     &kp P         &lt 2 BSLH
&kp LCTRL  &kp A     &kp S             &kp D   &kp F           &kp G   &kp LBKT   &kp DEL        &none          &kp PG_UP  &none    &kp RBKT   &kp H   &kp J       &kp K      &kp L     &kp SEMI      &mt RIGHT_COMMAND SQT
&mo 3      &kp Z     &kp X             &kp C   &kp V           &kp B                             &kp LC(W)      &kp PG_DN                      &kp N   &kp M       &kp COMMA  &kp DOT   &kp FSLH      &mo 3
&kp GLOBE  &kp LALT  &kp LEFT_COMMAND  &mo 1   &kp LEFT_SHIFT          &kp SPACE  &kp BACKSPACE  &kp GRAVE      &kp ESC    &kp TAB  &kp RET            &kp RSHIFT  &kp LEFT   &kp DOWN  &kp UP_ARROW  &kp RIGHT
            >;
        };

        numrow {
            display-name = "num";
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans        &trans                                      &trans  &trans        &trans        &trans        &trans        &trans        &trans
&none   &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT     &none                                       &trans  &kp CARET     &kp AMPS      &kp ASTRK     &kp LPAR      &kp RPAR      &none
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &none   &trans  &trans      &trans  &trans  &trans  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp RIGHT_COMMAND
&none   &trans        &trans        &trans        &trans        &trans                        &trans      &trans                  &trans        &trans        &trans        &trans        &trans        &none
&trans  &trans        &trans        &none         &trans                      &trans  &trans  &trans      &trans  &trans  &trans                &trans        &trans        &trans        &trans        &trans
            >;
        };

        vimarrow {
            display-name = "vim";
            bindings = <
&trans  &kp F1        &kp F2     &kp F3     &kp F4    &kp F5     &trans                                      &trans  &kp F6        &kp F7        &kp F8      &kp F9         &kp F10  &kp F11
&none   &trans        &trans     &trans     &trans    &trans     &none                                       &none   &kp LA(LEFT)  &kp LG(DOWN)  &kp LG(UP)  &kp LA(RIGHT)  &trans   &none
&trans  &kp NUMBER_0  &kp CARET  &kp PRCNT  &kp DLLR  &kp ASTRK  &none   &trans  &trans      &trans  &trans  &none   &kp LEFT      &kp DOWN      &kp UP      &kp RIGHT      &trans   &trans
&none   &trans        &trans     &trans     &trans    &kp HASH                   &trans      &trans                  &kp LG(LEFT)  &kp PG_DN     &kp PG_UP   &kp LG(RIGHT)  &trans   &none
&trans  &trans        &trans     &none      &trans               &trans  &trans  &trans      &trans  &trans  &trans                &trans        &trans      &trans         &trans   &trans
            >;
        };

        media {
            display-name = "media";
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &studio_unlock                                                   &studio_unlock  &trans  &trans  &trans      &trans             &trans           &trans
&none   &bt BT_PRV    &bt BT_NXT    &bt BT_CLR    &trans        &trans        &sys_reset                                                       &sys_reset      &trans  &trans  &trans      &trans             &trans           &none
&trans  &trans        &trans        &trans        &trans        &trans        &bootloader     &trans  &trans      &bl BL_INC  &trans           &bootloader     &trans  &trans  &trans      &trans             &trans           &trans
&none   &trans        &trans        &trans        &trans        &trans                                &trans      &bl BL_DEC                                   &trans  &trans  &kp C_PREV  &kp C_NEXT         &trans           &none
&trans  &trans        &trans        &none         &trans                      &trans          &trans  &trans      &trans      &rgb_ug RGB_TOG  &bl BL_TOG              &trans  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_PLAY_PAUSE
            >;
        };
    };
};
